    "pino": "^9.7.0",
    "pino-http": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^10.13.0",
    "prettier": "^3.5.3",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
